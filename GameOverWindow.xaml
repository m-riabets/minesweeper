<Window x:Class="Minesweeper.GameOverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Minesweeper"
        mc:Ignorable="d"
        Title="Minesweeper"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock x:Name="TimeText" Margin="0,10,0,0" HorizontalAlignment="Center"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button x:Name="NewGameButton" Content="New Game" Width="90" Height="30" Margin="5" Click="NewGameButton_Click"/>
            <Button x:Name="ShowBoardButton" Content="Show Board" Width="90" Height="30" Margin="5" Click="ShowBoardButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
